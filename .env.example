# Copy to .env for Docker Compose/backend and to frontend/.env.local for Next.js.
# Only NEXT_PUBLIC_* values may be exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (or legacy anon key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
# Supabase direct or session-pooler PostgreSQL URL; keep server-side.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GEMINI_API_KEY=
OPENAI_API_KEY=
